# Copy to .env.local. Everything is optional: without Supabase the game saves to this browser only.

# Co-op relay (npm run relay). Defaults to ws://<page host>:2567.
NEXT_PUBLIC_RELAY_URL=ws://localhost:2567

# Cloud accounts and saves (supabase/schema.sql). Enable anonymous sign-ins in the project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# For the relay (relay/.env or its environment): verify players' JWTs against this project.
# SUPABASE_URL=https://xxxx.supabase.co
